ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# MariaDB Configuration (Used when ENVIRONMENT=production)
DB_NAME=hms_prod
DB_USER=root
DB_PASSWORD=141778215aA!
DB_HOST=127.0.0.1
DB_PORT=3306

# SHA / DHA HIE credentials (AfyaLink developer portal)
SHA_HIE_BASE_URL=https://uat.dha.go.ke
SHA_HIE_USERNAME=
SHA_HIE_PASSWORD=
SHA_HIE_AGENT_ID=
SHA_HIE_CONSUMER_KEY=
SHA_HIE_CONSUMER_SECRET=
SHA_HIE_TIMEOUT_SECONDS=20
SHA_HIE_VERIFY_SSL=true
SHA_HIE_TOKEN_PATH=/v1/hie-auth
SHA_HIE_CLIENT_VERIFY_PATH=/v3/client-registry/fetch-client
SHA_HIE_ELIGIBILITY_PATH=/v2/eligibility
SHA_HIE_FACILITY_SEARCH_PATH=/v2/facility-search
# DHA Terminology ICD-11 (ILM middleware — auth JWT from SHA_HIE_BASE_URL)
SHA_HIE_TERMINOLOGY_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
SHA_HIE_ICD11_SEARCH_PATH=/clinical/concepts
SHA_HIE_ICD11_OWNER=WHO
SHA_HIE_ICD11_SOURCE=ICD-11
# DHA HPT medications (PPB via OCL — generic_concept_code for eRx)
SHA_HIE_HPT_OWNER=MOH-PPB
SHA_HIE_HPT_SOURCE=HPT
HPT_DHA_SUGGEST_ON_SELECT=true
HPT_DHA_REQUIRE_CODE=false

# Facility for eClaims / eRx headers
SHA_HIE_FACILITY_FR_CODE=
SHA_HIE_FACILITY_ID_TYPE=fr-code
SHA_HIE_FACILITY_NAME=
SHA_HIE_DEFAULT_INTERVENTION_OPD=SHA-18-005
SHA_HIE_DEFAULT_INTERVENTION_IPD=SHA-11-001
SHA_HIE_AUTO_SUBMIT_ON_INSURANCE=false

# Clinical Summary Generation / Shared Encounter (Kenya HIE)
SHA_HIE_CLINICAL_FHIR_BUNDLE_PATH=/clinical/fhir/bundle
SHA_HIE_ENCOUNTER_SYNC_PATH=/api/v1/encounter/sync

# WHO ICD-11 API (register at https://icd.who.int/icdapi)
ICD11_API_BASE_URL=https://id.who.int
ICD11_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
ICD11_RELEASE=2024-01
ICD11_LINEARIZATION=mms
ICD11_LANGUAGE=en
ICD11_TIMEOUT_SECONDS=20
ICD11_VERIFY_SSL=true
# Local ICD-11 tabulation (run: python manage.py sync_icd11)
ICD11_USE_LOCAL_DB=true
# On select: validate code still supported/unchanged via DHA Terminology Service
ICD11_DHA_VALIDATE_ON_SELECT=true
# If true, block selection when DHA is unreachable
ICD11_DHA_VALIDATE_STRICT=false
# ICD11_TABULATION_URL=https://icdcdn.who.int/static/releasefiles/{release}/SimpleTabulation-ICD-11-MMS-{language}.zip
